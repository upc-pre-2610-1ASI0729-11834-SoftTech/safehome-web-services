DB_URL=jdbc:postgresql://HOST/DB?sslmode=require
DB_USERNAME=USER
DB_PASSWORD=PASSWORD
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY
SENDGRID_FROM_EMAIL=your-email@example.com
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Optional Tuya IoT - keep disabled first for first deploy
TUYA_POLLING_ENABLED=false
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_ENDPOINT=https://openapi.tuyaus.com
TUYA_DEVICE_ID=
TUYA_MOTION_CODE=pir_state
TUYA_MOTION_VALUE=pir
TUYA_POLLING_DELAY_MS=1000
TUYA_MOTION_COOLDOWN_MS=120000
SAFEHOME_TUYA_PROPERTY_ID=
SAFEHOME_TUYA_DEVICE_ID=
SAFEHOME_TUYA_LATITUDE=-12.0464
SAFEHOME_TUYA_LONGITUDE=-77.0428

# Add Firebase URLs after frontend deploy
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://YOUR-FIREBASE-PROJECT.web.app,https://YOUR-FIREBASE-PROJECT.firebaseapp.com
